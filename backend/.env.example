# Copy to .env and replace all values. .env is ignored by Git.
DB_PASSWORD=replace-with-local-db-password
DB_URL=jdbc:postgresql://localhost:5432/repair
DB_USER=repair
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INTERNAL_SERVICE_TOKEN=replace-with-random-service-token-at-least-32-characters
DEV_PASSWORD=replace-with-local-demo-password
SPRING_PROFILES_ACTIVE=dev
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
FILE_ROOT=./data/files
MCP_URL=http://localhost:8089/mcp
MCP_TOKEN=
# Photo quality is enabled by default. false restores legacy automatic diagnosis.
PHOTO_QUALITY_ENABLED=true
